# Operating Mode: LIVE Production Configuration
# In LIVE mode, synthetic telemetry and seeded assets are COMPLETELY DISABLED.
# Every ingested event requires genuine provenance from real collectors or file imports.

PORT=5000
PLATFORM_MODE=LIVE
ENABLE_SYNTHETIC_DATA=false
ENABLE_SEED_DATA=false
ENABLE_ATTACK_SIMULATION=false
ALLOW_RUNTIME_MODE_SWITCH=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security Secrets
JWT_SECRET=cybermind_soc_super_secret_jwt_key_2026

# AI Integration (Optional Gemini API key)
# GEMINI_API_KEY=your_google_gemini_api_key_here
