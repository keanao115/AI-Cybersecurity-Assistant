# Operating Mode: DEMO Environment Configuration
# In DEMO mode, controlled synthetic flow generation, seed assets, and attack simulations may be enabled.
# All demonstration records carry explicit SYNTHETIC_DEMO and SEEDED_DEMO provenance tags.

PORT=5000
PLATFORM_MODE=DEMO
ENABLE_SYNTHETIC_DATA=true
ENABLE_SEED_DATA=true
ENABLE_ATTACK_SIMULATION=true
ALLOW_RUNTIME_MODE_SWITCH=true

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security Secrets
JWT_SECRET=cybermind_soc_super_secret_jwt_key_2026

# AI Integration (Optional Gemini API key)
# GEMINI_API_KEY=your_google_gemini_api_key_here
