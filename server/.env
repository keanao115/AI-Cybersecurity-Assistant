# CyberMind SOC Platform v3.0 — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ─── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=cybermind_soc_super_secret_jwt_key_2026

# ─── Real AI — Google Gemini ────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Without this key, the AI module runs in rule-based fallback mode (no crash)
GEMINI_API_KEY=

# ─── Optional: NVD API Key (higher rate limit: 50 req/30s vs 5 req/30s) ────────
# Get your free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ─── PostgreSQL (Optional — memory fallback used when unavailable) ────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Syslog UDP Receiver Port (default: 5514, non-root alternative to 514) ────
SYSLOG_PORT=5514

# ─── Real-Time Telemetry ────────────────────────────────────────────────────────
# Send test syslog: logger -n 127.0.0.1 -P 5514 "test security event"
# Or with netcat:   echo "<14>Jul 28 00:00:00 myhost sshd: Failed password" | nc -u 127.0.0.1 5514
